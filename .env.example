# URL absoluta, sem barra final. Usada em metadata e sitemap.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
# Opcional: endpoint HTTP público que recebe JSON e responde com HTTP 2xx.
# Sem endpoint, o formulário apenas valida e informa que nada foi enviado.
# Nunca coloque chaves privadas em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_CONTACT_ENDPOINT=
